{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "主窗口仅可使用已授权笔记库的会话操作；不授予任意路径、shell 或通用文件系统访问。",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-version",
    "allow-get-workspace",
    "allow-use-default-library",
    "allow-initialize-selected-library",
    "allow-choose-library",
    "allow-open-library-folder",
    "allow-new-note",
    "allow-create-notebook",
    "allow-rename-notebook",
    "allow-delete-notebook",
    "allow-update-note-organization",
    "allow-trash-note",
    "allow-restore-trashed-note",
    "allow-delete-trashed-note",
    "allow-set-view-preferences",
    "allow-open-note",
    "allow-save-note-text",
    "allow-save-note-content",
    "allow-stage-image-raw",
    "allow-preflight-image-insert",
    "allow-preflight-note-content",
    "allow-read-image-asset",
    "allow-activate-close-guard",
    "allow-complete-close",
    "allow-list-recovery-drafts",
    "allow-restore-recovery-as-copy",
    "allow-save-current-as",
    "allow-save-current-content-as",
    "allow-save-recovery-as",
    "allow-probe-external-changes",
    "allow-reconcile-external-changes",
    "allow-list-preserved-versions",
    "allow-open-preserved-version",
    "allow-restore-preserved-as-copy",
    "allow-resolve-preserved-version",
    "allow-save-preserved-as",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
